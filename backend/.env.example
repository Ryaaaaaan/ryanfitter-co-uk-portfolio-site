# Use the existing TradingLab Cognito USER POOL, but create a dedicated app client.
# Never commit real values, Cognito subjects, tokens or secrets to Git.
AWS_REGION=eu-west-2
COGNITO_USER_POOL_ID=eu-west-2_EXAMPLE
COGNITO_DOMAIN=https://example.auth.eu-west-2.amazoncognito.com
COGNITO_CLIENT_ID=APP_CLIENT_ID_FROM_CDK_OUTPUT
SITE_ORIGIN=https://ryanfitter.co.uk

# Existing TradingLab user must be explicitly allowlisted by Cognito sub.
# Add another sub, comma-separated, only after creating/approving that user in the SAME pool.
COGNITO_ALLOWED_SUBS=REPLACE_WITH_APPROVED_COGNITO_SUB
COOKIE_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
DIST_DIR=/opt/ryanfitter-portfolio/dist
