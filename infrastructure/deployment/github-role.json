{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Dedicated GitHub OIDC deployment role for the personal portfolio EC2 host only. Reuses existing GitHub OIDC provider.",
  "Resources": {
    "WebsiteDeployRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "RoleName": "RyanFitterPortfolioGitHubDeploy",
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Federated": {
                  "Fn::Sub": "arn:${AWS::Partition}:iam::${AWS::AccountId}:oidc-provider/token.actions.githubusercontent.com"
                }
              },
              "Action": "sts:AssumeRoleWithWebIdentity",
              "Condition": {
                "StringEquals": {
                  "token.actions.githubusercontent.com:aud": "sts.amazonaws.com",
                  "token.actions.githubusercontent.com:sub": "repo:Ryaaaaaan/ryanfitter-co-uk-portfolio-site:ref:refs/heads/main"
                }
              }
            }
          ]
        },
        "MaxSessionDuration": 3600,
        "Policies": [
          {
            "PolicyName": "DeployPersonalWebsiteOnly",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": "ssm:SendCommand",
                  "Resource": [
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:ssm:eu-west-2::document/AWS-RunShellScript"
                    },
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:ec2:eu-west-2:${AWS::AccountId}:instance/i-0266a151d81b9a47a"
                    }
                  ]
                },
                {
                  "Effect": "Allow",
                  "Action": "ssm:GetCommandInvocation",
                  "Resource": "*",
                  "Condition": {
                    "StringEquals": {
                      "aws:RequestedRegion": "eu-west-2"
                    }
                  }
                }
              ]
            }
          }
        ],
        "Tags": [
          {
            "Key": "Project",
            "Value": "RyanFitterPortfolio"
          }
        ]
      }
    }
  },
  "Outputs": {
    "DeployRoleArn": {
      "Value": {
        "Fn::GetAtt": [
          "WebsiteDeployRole",
          "Arn"
        ]
      }
    }
  }
}
